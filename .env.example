# Public browser configuration (not service-role secrets)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-only: Netlify Functions scope. Never prefix secrets with VITE_.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=nodus-private
APP_ORIGIN=
# Optional provider-neutral adapter described in docs/BACKEND.md
AI_PROVIDER_URL=
AI_PROVIDER_API_KEY=
# NODUS AI: server-only Netlify Function scope, never VITE_ or committed secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=8000
# Shared daily provider-call quotas require migration 002. No paid calls without shared quota.
# Optional unmetered bypass ONLY in verified local development; keep false on Netlify.
NODUS_AI_ALLOW_UNMETERED=false
NODUS_AI_DAILY_LIMIT=500
NODUS_AI_CLIENT_DAILY_LIMIT=50
